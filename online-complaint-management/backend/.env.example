# Copy this file to ".env" and fill in your own values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/complaint_management

# JWT - use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173

# First admin account (used ONLY by: npm run seed:admin)
# Public registration can never create an admin, so this script is the secure way to create one.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123
