# Optional. Leave these unset for local development (Vite proxies /api and /uploads to the backend).
# Set them only when the backend is hosted on a different domain (e.g. production).

# Full API URL, including /api
VITE_API_URL=http://localhost:5000/api

# Base URL used to load uploaded images (no trailing slash)
VITE_FILE_URL=http://localhost:5000
